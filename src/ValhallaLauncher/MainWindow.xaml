<Window x:Class="ValhallaLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Valhalla" Height="720" Width="1180" MinHeight="680" MinWidth="1080" WindowStartupLocation="CenterScreen" Background="#0C0C0B">
<Window.Resources>
 <SolidColorBrush x:Key="Gold" Color="#D6A84E"/><SolidColorBrush x:Key="GoldLight" Color="#F2D58B"/><SolidColorBrush x:Key="Panel" Color="#D9151513"/><SolidColorBrush x:Key="Panel2" Color="#E81B1A17"/><SolidColorBrush x:Key="Cream" Color="#F1E8DA"/>
 <Style x:Key="Nav" TargetType="Button"><Setter Property="Foreground" Value="#D8CFC1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="18,13"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="GoldButton" TargetType="Button"><Setter Property="Background" Value="#B8872F"/><Setter Property="Foreground" Value="#17120B"/><Setter Property="BorderBrush" Value="#E5BE69"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="20,12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="DarkButton" TargetType="Button"><Setter Property="Background" Value="#CC23211D"/><Setter Property="Foreground" Value="#EFE6D8"/><Setter Property="BorderBrush" Value="#5A5143"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#514738"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="9"/></Style>
</Window.Resources>
<Grid>
 <Image Source="background.png" Stretch="UniformToFill" Opacity="0.38"/><Rectangle Fill="#9A090908"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EB11110F" BorderBrush="#493F31" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="VALHALLA" Foreground="{StaticResource GoldLight}" FontFamily="Georgia" FontWeight="Bold" FontSize="27" Margin="22,25,10,4"/><TextBlock Text="MINECRAFT LAUNCHER" Foreground="#827768" FontSize="10" Margin="23,0,0,25"/>
    <Button Style="{StaticResource Nav}" Content="⌂   Accueil" Click="Accueil_Click"/><Button Style="{StaticResource Nav}" Content="◈   Modpack" Click="Modpack_Click"/><Button Style="{StaticResource Nav}" Content="⚙   Paramètres" Click="Parametres_Click"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="15,0,15,18"><Button Style="{StaticResource DarkButton}" Content="Compte Minecraft" Click="Compte_Click" Margin="0,0,0,9"/><TextBlock Text="Valhalla v0.4.6" Foreground="#736B60" HorizontalAlignment="Center" FontSize="10"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="ACCUEIL" Foreground="{StaticResource Cream}" FontFamily="Georgia" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="UpdateText" Text="Recherche des mises à jour..." Foreground="#A99E8F" FontSize="11" Margin="1,4,0,0"/></StackPanel><Border Grid.Column="1" Style="{StaticResource Card}" Padding="15,9"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ServerDot" Width="9" Height="9" Fill="#C2A65A" Margin="0,0,8,0"/><TextBlock x:Name="ServerStatusText" Text="Serveur : vérification..." Foreground="#E7DED1"/></StackPanel></Border></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="HomePage"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Card}" Margin="0,0,16,16" Padding="30" VerticalAlignment="Stretch"><Grid><Image Source="background.png" Stretch="UniformToFill" Opacity="0.60"/><Rectangle Fill="#5F000000"/><StackPanel VerticalAlignment="Bottom" Margin="12"><TextBlock Text="BIENVENUE DANS" Foreground="#F1E8DA" FontFamily="Georgia" FontSize="19"/><TextBlock Text="VALHALLA" Foreground="#FFF6E8" FontFamily="Georgia" FontSize="60" FontWeight="Bold"/></StackPanel></Grid></Border>
     <StackPanel Grid.Column="1"><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="SERVEUR VALHALLA" Foreground="{StaticResource GoldLight}" FontWeight="Bold"/><TextBlock Text="109.239.152.82:26065" Foreground="#EFE5D7" FontSize="15" Margin="0,8,0,12"/><Button Style="{StaticResource DarkButton}" Content="COPIER L’IP" Click="CopyIp_Click"/></StackPanel></Border><Border Style="{StaticResource Card}" Padding="20"><StackPanel><TextBlock Text="JEU ACTIF" Foreground="{StaticResource GoldLight}" FontWeight="Bold"/><TextBlock x:Name="HomePackText" Text="Vanilla • Minecraft 26.3" Foreground="#EFE5D7" Margin="0,8,0,4"/><TextBlock Text="Les changements de pack sont récupérés automatiquement." Foreground="#92887B" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border></StackPanel>
    </Grid>
    <Grid x:Name="ModpackPage" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}" Padding="26" Margin="0,0,0,16"><StackPanel><TextBlock Text="MODPACK ACTIF" Foreground="{StaticResource GoldLight}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="PackNameText" Text="VANILLA" Foreground="{StaticResource Cream}" FontFamily="Georgia" FontSize="32" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock x:Name="PackInfoText" Text="Minecraft 26.3 • Vanilla" Foreground="#AAA093"/><Separator Margin="0,18" Background="#443B30"/><Button Style="{StaticResource GoldButton}" Content="VÉRIFIER / PRÉPARER LE MODPACK" Click="Prepare_Click" Width="280" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Le launcher utilisera le modpack défini par Valhalla. Quand le serveur changera de pack, cette page se mettra à jour depuis la configuration distante." Foreground="#9D9386" TextWrapping="Wrap" MaxWidth="650" HorizontalAlignment="Left"/></StackPanel></Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed"><StackPanel><Border Style="{StaticResource Card}" Padding="26" Margin="0,0,0,16"><StackPanel><TextBlock Text="MÉMOIRE ALLOUÉE À MINECRAFT" Foreground="{StaticResource GoldLight}" FontWeight="Bold"/><TextBlock x:Name="RamValueText" Text="8 Go" Foreground="{StaticResource Cream}" FontFamily="Georgia" FontSize="32" Margin="0,8,0,2"/><Slider x:Name="RamSlider" Minimum="4" Maximum="16" Value="8" TickFrequency="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="RamSlider_ValueChanged" Margin="0,12,0,0"/><Grid Margin="0,2,0,0"><TextBlock Text="4 Go" Foreground="#887E71"/><TextBlock Text="16 Go" Foreground="#887E71" HorizontalAlignment="Right"/></Grid></StackPanel></Border><Border Style="{StaticResource Card}" Padding="26"><StackPanel><CheckBox x:Name="DirectConnectCheck" Content="Connexion directe au serveur au lancement" Foreground="#E8DED0" IsChecked="True" Checked="DirectConnect_Changed" Unchecked="DirectConnect_Changed"/><Button Style="{StaticResource DarkButton}" Content="VÉRIFIER LES MISES À JOUR" Click="CheckUpdate_Click" Width="230" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border></StackPanel></Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Valhalla est prêt." Foreground="#9E9589" VerticalAlignment="Center"/><Button x:Name="PlayButton" Grid.Column="1" Style="{StaticResource GoldButton}" Content="⚔   JOUER" FontFamily="Georgia" FontSize="19" Padding="38,15" Click="Play_Click"/></Grid>
  </Grid>
 </Grid>
</Grid></Window>
<Window x:Class="ValhallaLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Valhalla" Width="1440" Height="900" MinWidth="1100" MinHeight="690"
 WindowStartupLocation="CenterScreen" Background="#090806">
 <Window.Resources>
  <Style x:Key="Hotspot" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Opacity" Value="0.01"/></Style>
  <Style x:Key="GoldAction" TargetType="Button"><Setter Property="Background" Value="#D2A447"/><Setter Property="Foreground" Value="#171109"/><Setter Property="BorderBrush" Value="#F0CE79"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid>
  <Image Source="launcher-ui.png" Stretch="Fill"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0">
    <Button Style="{StaticResource Hotspot}" Margin="12,170,12,650" Click="Accueil_Click" ToolTip="Accueil"/>
    <Button Style="{StaticResource Hotspot}" Margin="12,225,12,595" Click="Modpack_Click" ToolTip="Modpack"/>
    <Button Style="{StaticResource Hotspot}" Margin="12,280,12,540" Click="Parametres_Click" ToolTip="Paramètres"/>
    <Button Style="{StaticResource Hotspot}" VerticalAlignment="Bottom" Height="62" Margin="12,0,12,28" Click="Compte_Click" ToolTip="Compte"/>
   </Grid>
   <Grid Grid.Column="1">
    <Grid x:Name="HomePage">
     <!-- Live values placed directly inside the existing artwork cards: no duplicate panels -->
     <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="330" Height="96" Margin="0,86,38,0">
      <StackPanel Margin="18,8,12,0">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="ServerDot" Width="10" Height="10" Fill="#777" Margin="0,0,9,0"/><TextBlock x:Name="ServerStatusText" Text="VÉRIFICATION..." Foreground="#E4BD69" FontWeight="Bold"/></StackPanel>
       <TextBlock x:Name="ServerAddressText" Text="109.239.152.82:26065" Foreground="#F3EBDD" FontSize="14" Margin="19,4,0,0"/>
       <TextBlock x:Name="ServerPlayersText" Text="Joueurs : --/--" Foreground="#C6B9A6" Margin="19,3,0,0"/>
      </StackPanel>
      <Button Style="{StaticResource Hotspot}" Click="CopyIp_Click" ToolTip="Copier l'adresse"/>
     </Grid>

     <!-- Transparent interactive RAM control aligned with the settings card -->
     <Grid HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="390" Height="142" Margin="430,0,0,170">
      <TextBlock x:Name="HomeRamValueText" Text="8 Go / 16 Go" Foreground="#E7D7B6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,18,0"/>
      <Slider x:Name="HomeRamSlider" Minimum="4" Maximum="16" Value="8" TickFrequency="1" IsSnapToTickEnabled="True" Height="28" Margin="26,50,20,0" VerticalAlignment="Top" ValueChanged="HomeRamSlider_ValueChanged"/>
      <ComboBox x:Name="MinecraftVersionCombo" Height="32" Margin="26,0,20,12" VerticalAlignment="Bottom" SelectionChanged="MinecraftVersion_Changed" Background="#261F17" Foreground="#E7D7B6" BorderBrush="#75603E">
       <ComboBoxItem Content="26.3" IsSelected="True"/>
      </ComboBox>
     </Grid>

     <!-- Account actions aligned to the existing Microsoft card -->
     <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="330" Height="150" Margin="0,0,48,160">
      <TextBlock x:Name="AccountStateText" Text="Non connecté" Foreground="#F3EBDD" FontWeight="Bold" FontSize="16" Margin="22,42,15,0" VerticalAlignment="Top"/>
      <Button x:Name="AccountActionButton" Style="{StaticResource Hotspot}" Height="40" Margin="18,0,18,38" VerticalAlignment="Bottom" Content="CONNEXION" Click="Compte_Click" ToolTip="Connexion Microsoft"/>
      <Button x:Name="DisconnectButton" Style="{StaticResource Hotspot}" Height="32" Margin="18,0,18,3" VerticalAlignment="Bottom" Content="DÉCONNEXION" IsEnabled="False" Click="Disconnect_Click" ToolTip="Déconnexion Microsoft"/>
     </Grid>

     <Button x:Name="PlayButton" Style="{StaticResource Hotspot}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="455" Height="92" Margin="0,0,38,18" Click="Play_Click" ToolTip="Jouer"/>
     <TextBlock x:Name="HomePackText" Visibility="Collapsed"/>
    </Grid>
    <Grid x:Name="ModpackPage" Visibility="Collapsed" Background="#E511100E">
     <Border Width="700" Height="360" Background="#E51A1814" BorderBrush="#796340" BorderThickness="1" CornerRadius="10" Padding="34">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="MODPACK VALHALLA" Foreground="#E4BD69" FontSize="14" FontWeight="Bold"/><TextBlock x:Name="PackNameText" Text="VANILLA" Foreground="#F3EBDD" FontFamily="Georgia" FontSize="42" FontWeight="Bold" Margin="0,14,0,5"/><TextBlock x:Name="PackInfoText" Foreground="#BDB2A3" FontSize="15"/><Button Style="{StaticResource GoldAction}" Content="VÉRIFIER / PRÉPARER LE MODPACK" Height="52" Margin="0,35,0,0" Click="Prepare_Click"/></StackPanel>
     </Border>
    </Grid>
    <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="#E511100E">
     <Border Width="700" Height="400" Background="#E51A1814" BorderBrush="#796340" BorderThickness="1" CornerRadius="10" Padding="34">
      <StackPanel VerticalAlignment="Center"><TextBlock Text="PARAMÈTRES" Foreground="#E4BD69" FontFamily="Georgia" FontSize="27" FontWeight="Bold"/><TextBlock Text="Mémoire allouée à Minecraft" Foreground="#E8DFD1" Margin="0,28,0,6"/><TextBlock x:Name="RamValueText" Text="8 Go" Foreground="#F1D58B" FontSize="28" FontWeight="Bold"/><Slider x:Name="RamSlider" Minimum="4" Maximum="16" Value="8" TickFrequency="2" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ValueChanged="RamSlider_ValueChanged" Margin="0,12,0,18"/><CheckBox x:Name="DirectConnectCheck" Content="Connexion directe au serveur" Foreground="#E8DFD1" IsChecked="True" Checked="DirectConnect_Changed" Unchecked="DirectConnect_Changed"/><Button Style="{StaticResource GoldAction}" Content="VÉRIFIER LES MISES À JOUR" Height="48" Margin="0,28,0,0" Click="CheckUpdate_Click"/></StackPanel>
     </Border>
    </Grid>
    <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
    <TextBlock x:Name="UpdateText" Visibility="Collapsed"/>
    <TextBlock x:Name="StatusText" Foreground="#D9CCBA" Background="#B811100E" Padding="10,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24,0,0,14"/>
   </Grid>
  </Grid>
 </Grid>
</Window>